VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN min_area_pad_on_l_pin ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
TRACKS X 170 DO 58 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 58 STEP 340 LAYER met1 ;
TRACKS X 230 DO 43 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 43 STEP 460 LAYER met2 ;
GCELLGRID X 0 DO 5 STEP 5000 ;
GCELLGRID Y 0 DO 5 STEP 5000 ;
COMPONENTS 1 ;
- u1 l_pin_cell + FIXED ( 10000 10000 ) N ;
END COMPONENTS
PINS 0 ;
END PINS
NETS 1 ;
- n1 ( u1 Z )
  + ROUTED met1 ( 9985 10185 ) RECT ( 0 0 230 230 )
  ;
END NETS
END DESIGN
